{
  "name": "jarvis-personal-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "JARVIS: local-first AI assistant with voice, memory, notes, tasks, optional AI API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
